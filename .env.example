# Azure AD Application Configuration for Microsoft Graph Presence API
# You need to create an Azure AD app registration to get this client ID
# Instructions: See README-PRESENCE-SETUP.md
VITE_AZURE_CLIENT_ID=your-azure-client-id-here

# Backend API Configuration
# For production: Use your Azure App Service URL
# For development: Use localhost
VITE_API_URL=http://localhost:3001
